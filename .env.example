# Copier ce fichier vers .env et renseigner les valeurs.
# Ne jamais committer le fichier .env

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Oracle (base métier)
ORACLE_NAME=YOUR_SERVICE_OR_SID
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Active Directory / LDAP
LDAP_SERVER=ldap://your-ad-server:389
LDAP_BASE_DN=OU=Users,DC=example,DC=local
LDAP_SERVICE_USER=DOMAIN\service_account
LDAP_SERVICE_PASSWORD=your_ldap_password
